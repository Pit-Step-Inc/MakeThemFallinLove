# ==========================================================
#  MakeThemFallinLove — .gitattributes
#  改行コードの正規化 + バイナリ判定 + diff/LFS 設定
# ==========================================================

# ---------- 既定: Git に自動判定させ、テキストは LF で保存 ----------
* text=auto eol=lf

# ---------- テキスト（明示） ----------
*.html      text eol=lf diff=html
*.htm       text eol=lf diff=html
*.css       text eol=lf diff=css
*.scss      text eol=lf diff=css
*.sass      text eol=lf diff=css
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.mts       text eol=lf
*.cts       text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.json5     text eol=lf
*.md        text eol=lf diff=markdown
*.mdx       text eol=lf diff=markdown
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.glsl      text eol=lf
*.vert      text eol=lf
*.frag      text eol=lf
*.wgsl      text eol=lf
*.py        text eol=lf diff=python
*.sh        text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
Dockerfile  text eol=lf
LICENSE     text eol=lf

# ---------- Windows 専用スクリプトは CRLF を維持 ----------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# ---------- バイナリ（差分・マージを試みない） ----------
# 画像
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.avif      binary
*.ico       binary
*.bmp       binary
*.tga       binary
*.tif       binary
*.tiff      binary
*.psd       binary
*.xcf       binary
*.ase       binary
*.aseprite  binary
*.ktx2      binary
*.basis     binary
*.dds       binary
*.hdr       binary
*.exr       binary

# 音声（FL Studio 書き出し・ゲーム内 BGM/SE）
*.wav       binary
*.mp3       binary
*.ogg       binary
*.oga       binary
*.m4a       binary
*.aac       binary
*.flac      binary
*.aif       binary
*.aiff      binary
*.opus      binary
*.mid       binary
*.midi      binary

# 動画
*.mp4       binary
*.webm      binary
*.mov       binary

# 3D モデル（Blender 出力・ソース）
*.glb       binary
*.gltf      binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.dae       binary
*.usdz      binary
*.abc       binary
*.ply       binary
*.stl       binary

# DAW プロジェクト
*.flp       binary
*.als       binary
*.rpp       -text

# フォント
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary

# アーカイブ / その他
*.zip       binary
*.7z        binary
*.gz        binary
*.tar       binary
*.rar       binary
*.pdf       binary
*.wasm      binary
*.pak       binary
*.bin       binary

# ---------- ロックファイルのマージ／差分ノイズ抑制 ----------
package-lock.json   -diff linguist-generated=true
pnpm-lock.yaml      -diff linguist-generated=true
yarn.lock           -diff linguist-generated=true
bun.lockb           binary linguist-generated=true

# ---------- GitHub の言語統計・差分表示 ----------
dist/**             linguist-generated=true
assets/**/*.png     linguist-vendored=true
assets/**/*.gif     linguist-vendored=true
assets/**/*.wav     linguist-vendored=true
assets/**/*.ogg     linguist-vendored=true
assets/**/*.m4a     linguist-vendored=true
assets/**/*.blend   linguist-vendored=true
vendor/**           linguist-vendored=true
*.min.js            linguist-generated=true -diff
*.min.css           linguist-generated=true -diff

# ---------- アーカイブ（git archive）から除外 ----------
.gitattributes  export-ignore
.gitignore      export-ignore
.github/        export-ignore
tests/          export-ignore
docs/           export-ignore
*.blend         export-ignore
*.flp           export-ignore

# ==========================================================
#  Git LFS（大容量アセット向け）
#  使う場合: git lfs install && 下のブロックのコメントを外す
#  ※ GitHub Pages / Netlify / Vercel など配信先が LFS 非対応だと
#    ビルド時に取得できないことがあるため、最終配信物は LFS に入れず
#    「制作用ソース（.blend / .flp / 生 wav）」だけを LFS に載せるのが安全。
# ==========================================================
# *.blend  filter=lfs diff=lfs merge=lfs -text
# *.flp    filter=lfs diff=lfs merge=lfs -text
# *.psd    filter=lfs diff=lfs merge=lfs -text
# *.wav    filter=lfs diff=lfs merge=lfs -text
# *.aiff   filter=lfs diff=lfs merge=lfs -text
# *.fbx    filter=lfs diff=lfs merge=lfs -text
# *.exr    filter=lfs diff=lfs merge=lfs -text
# *.mp4    filter=lfs diff=lfs merge=lfs -text
